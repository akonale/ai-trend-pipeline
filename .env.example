# Copy to .env.prod (prod compose) and fill in. Never commit real values.

# Required
ANTHROPIC_API_KEY=sk-ant-your-key-here
BLUESKY_HANDLE=your-handle.bsky.social
BLUESKY_APP_PASSWORD=your-bluesky-app-password
POSTGRES_PASSWORD=choose-a-strong-password
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token
TEMPORAL_UI_URL=https://temporal.example.com

# Optional (defaults shown; see infra/compose.prod.yaml and src/ai_trend_pipeline/config.py)
# DAILY_CHART_CAP=10
# ILLUSTRATION_PROVIDER=illustrated-card
# SOURCE_ENABLED=hn
# SOURCE_POLL_LIMIT=30
# SOURCE_POLL_INTERVAL_S=300
# SOURCE_POLL_TIMEOUT_S=15.0
# CANDIDATE_REVIEW_TIMEOUT_S=172800
# SOURCE_CANDIDATE_BUDGET=20

# AI-drawn images (off by default; every story costs one Anthropic call, capped per UTC day)
DRAWN_IMAGES_ENABLED=false
# DRAWN_IMAGES_MODEL=claude-sonnet-5-5
# DRAWN_IMAGES_COUNT=3
# DRAWN_IMAGES_DAILY_CAP=20
